{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "habitat-test-ui",
  "homepage": "https://habitat-test-ui.example.com",
  "items": [
    {
      "name": "button",
      "type": "registry:component",
      "title": "Button",
      "description": "Animated button with ripple, particles, magnetic hover, orbiting border, and brand logo variant.",
      "dependencies": ["class-variance-authority"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:component",
          "target": "components/ui/button.tsx"
        }
      ],
      "css": {
        "@keyframes": {
          "ripple": {
            "0%": { "transform": "scale(1)", "opacity": "0.5" },
            "100%": { "transform": "scale(20)", "opacity": "0" }
          },
          "particle-burst": {
            "0%": { "transform": "translate(0, 0) scale(1)", "opacity": "1" },
            "100%": { "transform": "translate(var(--particle-tx), var(--particle-ty)) scale(0)", "opacity": "0" }
          },
          "orbit-spin": {
            "from": { "--orbit-angle": "0deg" },
            "to": { "--orbit-angle": "360deg" }
          },
          "logo-entrance": {
            "0%": { "opacity": "0", "transform": "scale(0.5) rotate(-10deg)", "filter": "blur(4px)" },
            "100%": { "opacity": "1", "transform": "scale(1) rotate(0deg)", "filter": "blur(0)" }
          }
        },
        "@utility": {
          "animate-ripple": { "animation": "ripple 0.65s ease-out forwards" },
          "animate-particle-burst": { "animation": "particle-burst 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards" },
          "animate-orbit-spin": { "animation": "orbit-spin 2.5s linear infinite" },
          "animate-logo-entrance": { "animation": "logo-entrance 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards" }
        }
      }
    },
    {
      "name": "agentic-layout",
      "type": "registry:block",
      "title": "Agentic Layout",
      "description": "T3 Chat-style agentic layout with fuzzy glassmorphism aesthetics. Includes sidebar, message thread, and chat input.",
      "dependencies": ["lucide-react"],
      "registryDependencies": ["scroll-area", "avatar", "separator", "tooltip", "badge", "utils"],
      "files": [
        {
          "path": "src/components/ui/agentic-layout.tsx",
          "type": "registry:component",
          "target": "components/ui/agentic-layout.tsx"
        }
      ]
    }
  ]
}
